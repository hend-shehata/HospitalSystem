@model Appointment

<div class="container py-5">

    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">

            <div class="card shadow border-0">
                <div class="card-body p-4">

                    <h2 class="text-center mb-4">
                        Make Appointment
                    </h2>

                    <!-- Doctor Information -->
                    <div class="mb-4 p-3 bg-light rounded">
                        <h5>Doctor Information</h5>

                        <p class="mb-1">
                            <strong>Doctor:</strong>
                            @ViewBag.Doctor.DoctorName
                        </p>

                        <p class="mb-0">
                            <strong>Specialization:</strong>
                            @ViewBag.Doctor.Specialization
                        </p>
                    </div>
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            @ViewBag.Error
                        </div>
                    }

                    <form method="post">

                        <!-- Doctor Id -->
                        <input type="hidden"
                               name="DoctorId"
                               value="@ViewBag.Doctor.Id" />

                        <!-- Patient Name -->
                        <div class="mb-3">
                            <label class="form-label">
                                Patient Name
                            </label>

                            <input type="text"
                                   name="PatientName"
                                   class="form-control"
                                   placeholder="Enter patient name"
                                   required />
                        </div>

                        <!-- Date -->
                        <div class="mb-3">
                            <label class="form-label">
                                Date
                            </label>

                            <input type="date"
                                   name="Date"
                                   class="form-control"
                                   required />
                        </div>

                        <!-- Time -->
                        <div class="mb-4">
                            <label class="form-label">
                                Time
                            </label>

                            <input type="time"
                                   name="Time"
                                   class="form-control"
                                   required />
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Confirm Booking
                        </button>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>